{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landing",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "dnevnik",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "dnevnik/server.js"
      ],
      "port": 4321
    },
    {
      "name": "magic-pages",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "pages",
        "dev",
        "--cwd",
        "pages-magic",
        "--port",
        "8788"
      ],
      "port": 8788
    },
    {
      "name": "main-pages",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "pages",
        "dev",
        "--port",
        "8789"
      ],
      "port": 8789
    }
  ]
}
